generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_LINK")
}

// User model

model User {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  username String
  password String
}

model Photoset {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  title String
  service Service
  images String[]
  createdAt DateTime @default(now())
}

enum Service {
  PERSONAL_PHOTO
  COMMERCIAL_PHOTO
  PODCASTS
  MUSIC_VIDEOS
}